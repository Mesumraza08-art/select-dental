# Copy this file to .env.local and fill in the values.

# The live website address, no trailing slash. Used for canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.ca

# Keep search engines out until launch day. Set to true only on the live site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Shows "to be supplied" markers for missing details. Set to false for launch.
NEXT_PUBLIC_PREVIEW_PLACEHOLDERS=true

# Google Analytics 4 measurement ID (loads only after the visitor accepts analytics cookies).
NEXT_PUBLIC_GA_ID=

# Endpoint provided by the practice management / booking system that receives booking requests.
NEXT_PUBLIC_BOOKING_ENDPOINT=
